    "settings.privacy_body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 不需要账号，不收集个人信息，不含广告与第三方统计。昵称、头像只在你加入房间时发送给同一局域网里的房主，游戏结束后房间数据即清除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no personal data collection, no ads or third-party analytics. Your nickname and avatar are only sent to the host on your local network when you join, and room data is cleared when the game ends."
          }
        }
      }
    },
