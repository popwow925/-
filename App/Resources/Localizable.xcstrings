    "create.strong_cards": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强互动坑人卡（偷水晶等）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strong sabotage cards (steal crystals etc.)"
          }
        }
      }
    },
    "create.friendly_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭强互动、只用温和任务，适合有长辈或小朋友的局。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strong cards are off and missions stay mild by default — good for mixed-age groups."
          }
        }
      }
    },
    "create.network_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有人需要在同一个 Wi-Fi 下，或打开蓝牙与 Wi-Fi。第一次创建时系统会询问“本地网络”权限，请选择允许。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone should be on the same Wi-Fi, or have Bluetooth and Wi-Fi on. The first time, iOS asks for Local Network access — please allow it."
          }
        }
      }
    },
    "create.open": {
      "extractionState": "manual",
      "localizations": {
