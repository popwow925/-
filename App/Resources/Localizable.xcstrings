    "home.demo": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单机演示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo demo"
          }
        }
      }
    },
    "home.demo_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和 3 个机器人试玩一局，完全离线，不需要联网或授权。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a game with 3 bots. Fully offline, no network or permission needed."
          }
        }
      }
    },
    "home.create": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
