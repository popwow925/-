    "onboarding.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昵称和头像只保存在这台设备上，加入房间时才会发给房主。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your nickname and avatar stay on this device and are only sent to the host when you join a room."
          }
        }
      }
    },
    "onboarding.start": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's go"
          }
        }
      }
    },
    "onboarding.privacy": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要账号，不收集个人信息，没有广告。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no personal data collected, no ads."
