    "onboarding.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先给自己起个名字"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a name first"
          }
