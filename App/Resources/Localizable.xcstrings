      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全员的大屏和题目都用这个语言显示，与手机系统语言无关。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone sees game texts in this language, whatever their phone language is."
          }
        }
      }
    },
    "create.missions": {
      "extractionState": "manual",
