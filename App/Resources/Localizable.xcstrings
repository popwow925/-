    "home.create_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设备当主持：投到电视上，大家用自己的手机加入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device hosts: cast it to a TV, everyone joins with their own phone."
          }
        }
      }
    },
