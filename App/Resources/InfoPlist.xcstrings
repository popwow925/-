    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在同一个局域网内发现并连接朋友的设备，一起玩派对游戏。不会上传任何数据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to find and connect to your friends' devices on the same local network for party games. No data is uploaded."
          }
        }
      }
    }
  }
